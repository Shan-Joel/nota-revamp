---
import PenFrame from "@/components/PenFrame.astro";

interface Props {
  frames: { src: string; alt: string }[];
  headline: string;
  headlineItalic: string;
  details: { label: string; note: string }[];
  grid: {
    heading: string;
    headingItalic: string;
    paragraph: string;
    items: { title: string; desc: string }[];
    video: { src: string; poster: string };
  };
}

const { frames, headline, headlineItalic, details, grid } = Astro.props;
---

<section id="inside" data-inside-box class="scroll-mt-20">
  <div data-pen-scene class="relative">
    <div
      data-pen-pin
      class="bg-background relative z-10 flex h-[100svh] items-center overflow-hidden"
    >
      {
        frames.map((frame) => (
          <div data-pen-frame class="absolute inset-0">
            <PenFrame src={frame.src} alt={frame.alt} insetTop="5rem" insetBottom="2rem" />
          </div>
        ))
      }
      <div class="from-background/90 absolute inset-0 bg-gradient-to-r via-transparent to-transparent">
      </div>

      <div class="relative mx-auto w-full max-w-[1600px] px-5 sm:px-8">
        <h2 class="display text-5xl sm:text-8xl">
          {headline} <span class="italic">{headlineItalic}</span>
        </h2>
        <ul class="mt-10 flex flex-col gap-5">
          {
            details.map((d) => (
              <li data-detail class="max-w-xs">
                <p class="text-[15px]">{d.label}</p>
                <p class="text-muted-foreground text-[13px]">{d.note}</p>
              </li>
            ))
          }
        </ul>
      </div>
    </div>
  </div>

  <div class="mx-auto max-w-[1600px] px-5 py-24 sm:px-8 sm:py-32" data-box-grid>
    <div class="grid gap-8 lg:grid-cols-12 lg:items-end">
      <h3 class="display text-4xl sm:text-6xl lg:col-span-7 lg:text-7xl" data-box-item>
        {grid.heading} <span class="italic">{grid.headingItalic}</span>
      </h3>
      <p
        class="text-muted-foreground max-w-md text-[15px] leading-relaxed lg:col-span-4 lg:col-start-9"
        data-box-item
      >
        {grid.paragraph}
      </p>
    </div>

    <div class="mt-14 grid gap-px sm:mt-20 lg:grid-cols-12">
      <figure
        class="bg-surface relative aspect-[4/3] overflow-hidden lg:col-span-7 lg:aspect-auto lg:min-h-[36rem]"
        data-box-item
      >
        <video
          data-box-video
          src={grid.video.src}
          poster={grid.video.poster}
          class="absolute inset-0 h-full w-full object-cover"
          muted
          loop
          playsinline
          preload="none"
        />
        <div class="from-background/60 absolute inset-0 bg-gradient-to-t via-transparent to-transparent">
        </div>
      </figure>

      <ol class="grid auto-rows-fr gap-px lg:col-span-5" data-box-rows>
        {
          grid.items.map((item, i) => (
            <li
              data-box-row
              class="bg-surface/60 hover:bg-surface flex gap-6 p-8 transition-colors duration-500 sm:p-10"
            >
              <span
                class="text-primary pt-2 text-[11px] tracking-[0.22em] tabular-nums"
                aria-hidden="true"
              >
                {String(i + 1).padStart(2, "0")}
              </span>
              <div>
                <p class="display text-2xl sm:text-3xl">{item.title}</p>
                <p class="text-muted-foreground mt-2 max-w-sm text-[14px] leading-relaxed">
                  {item.desc}
                </p>
              </div>
            </li>
          ))
        }
      </ol>
    </div>
  </div>
</section>

<script>
  import { initGsap } from "@/lib/motion";
  import { autoplayWhenNear } from "@/lib/video";

  const root = document.querySelector<HTMLElement>("[data-inside-box]");

  initGsap(root, ({ gsap, root, reduced }) => {
    const frames = Array.from(root.querySelectorAll<HTMLElement>("[data-pen-frame]"));
    if (frames.length > 1) {
      gsap.set(frames.slice(1), { opacity: 0 });
      const tl = gsap.timeline({
        scrollTrigger: {
          trigger: root.querySelector("[data-pen-scene]"),
          start: "top top",
          end: "+=250%",
          pin: root.querySelector("[data-pen-pin]"),
          scrub: 0.7,
        },
      });
      frames.forEach((f, i) => {
        if (i === 0) return;
        tl.to(frames[i - 1]!, { opacity: 0, duration: 1 }, i - 1).to(
          f,
          { opacity: 1, duration: 1 },
          i - 1,
        );
      });
      root.querySelectorAll<HTMLElement>("[data-detail]").forEach((d, i) => {
        gsap.fromTo(
          d,
          { opacity: 0, x: -20 },
          {
            opacity: 1,
            x: 0,
            duration: 0.6,
            ease: "power2.out",
            scrollTrigger: {
              trigger: root.querySelector("[data-pen-scene]"),
              start: `top+=${(i + 1) * 25}% top`,
              toggleActions: "play none none reverse",
            },
          },
        );
      });
    }

    const video = root.querySelector<HTMLVideoElement>("[data-box-video]");
    if (video) autoplayWhenNear(video);

    if (reduced) return;
    gsap.from(root.querySelectorAll("[data-box-item]"), {
      opacity: 0,
      y: 36,
      duration: 0.9,
      ease: "power3.out",
      stagger: 0.1,
      scrollTrigger: { trigger: root.querySelector("[data-box-grid]"), start: "top 80%", once: true },
    });
    gsap.from(root.querySelectorAll("[data-box-row]"), {
      opacity: 0,
      y: 28,
      duration: 0.9,
      ease: "power3.out",
      stagger: 0.1,
      scrollTrigger: { trigger: root.querySelector("[data-box-rows]"), start: "top 80%", once: true },
    });
    if (video) {
      gsap.fromTo(
        video,
        { scale: 1.12 },
        {
          scale: 1,
          ease: "none",
          scrollTrigger: {
            trigger: video.parentElement,
            start: "top bottom",
            end: "bottom top",
            scrub: true,
          },
        },
      );
    }
  });
</script>
