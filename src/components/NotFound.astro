---
import type { NavLink } from "@/content/homepage";

interface Props {
  code: string;
  eyebrow: string;
  headline: string;
  headlineItalic: string;
  body: string;
  primaryCta: NavLink;
  secondaryCta: NavLink;
}

const { code, eyebrow, headline, headlineItalic, body, primaryCta, secondaryCta } = Astro.props;
---

<section data-not-found class="relative flex flex-1 items-center overflow-hidden pt-28 pb-20">
  <div
    class="relative mx-auto grid w-full max-w-[1600px] items-center gap-10 px-5 sm:px-8 lg:grid-cols-12 lg:gap-8"
  >
    <div class="lg:col-span-7">
      <p class="eyebrow mb-8" data-nf-meta>{eyebrow}</p>

      <h1 class="display text-[14vw] leading-[0.9] sm:text-[10vw] lg:text-[6.5vw]">
        <span class="block overflow-hidden" data-nf-line>{headline}</span>
        <span class="relative block w-fit">
          <span class="block overflow-hidden italic" data-nf-line>{headlineItalic}</span>
          <svg
            class="text-primary absolute -bottom-[0.14em] left-0 h-[0.3em] w-full"
            viewBox="0 0 400 24"
            preserveAspectRatio="none"
            fill="none"
            aria-hidden="true"
          >
            <path
              class="nf-stroke"
              d="M3 15 C 80 4, 160 21, 240 11 S 360 5, 397 13"
              stroke="currentColor"
              stroke-width="2.5"
              stroke-linecap="round"
              pathLength="1"
              data-nf-stroke></path>
          </svg>
        </span>
      </h1>

      <div
        class="hairline mt-14 flex flex-col gap-6 pt-6 sm:flex-row sm:items-end sm:justify-between"
      >
        <p class="text-muted-foreground max-w-md text-[15px] leading-relaxed" data-nf-meta>
          {body}
        </p>
        <div class="flex shrink-0 items-center gap-5" data-nf-meta>
          <a
            href={primaryCta.href}
            class="bg-foreground text-background group/home inline-flex items-center gap-2 rounded-full px-6 py-3 text-[13px] font-medium transition-transform duration-300 hover:scale-[1.03]"
          >
            <svg
              class="size-3.5 transition-transform duration-300 group-hover/home:-translate-x-0.5"
              viewBox="0 0 16 16"
              fill="none"
              stroke="currentColor"
              stroke-width="1.5"
              stroke-linecap="round"
              stroke-linejoin="round"
              aria-hidden="true"
            >
              <path d="M13 8H3M7 4L3 8l4 4"></path>
            </svg>
            {primaryCta.label}
          </a>
          <a
            href={secondaryCta.href}
            class="text-muted-foreground hover:text-foreground text-[13px] transition-colors duration-300"
          >
            {secondaryCta.label}
          </a>
        </div>
      </div>
    </div>

    <div class="@container order-first select-none lg:order-none lg:col-span-5" aria-hidden="true">
      <p class="display nf-code text-center text-[62cqi] whitespace-nowrap lg:text-right" data-nf-code>
        {code}
      </p>
    </div>
  </div>
</section>

<style>
  .nf-code {
    line-height: 0.85;
    letter-spacing: -0.02em;
    color: transparent;
    -webkit-text-stroke: 1px var(--color-border);
    -webkit-mask-image: linear-gradient(to bottom, #000 30%, transparent 100%);
    mask-image: linear-gradient(to bottom, #000 30%, transparent 100%);
  }

  .nf-stroke {
    stroke-dasharray: 1;
    stroke-dashoffset: 0;
  }
</style>

<script>
  import { initGsap, splitChars } from "@/lib/motion";

  const root = document.querySelector<HTMLElement>("[data-not-found]");

  initGsap(root, ({ gsap, root, reduced }) => {
    if (reduced) return;

    const chars = [...root.querySelectorAll<HTMLElement>("[data-nf-line]")].flatMap((line) =>
      splitChars(line),
    );
    const code = root.querySelector<HTMLElement>("[data-nf-code]");
    const stroke = root.querySelector<SVGPathElement>("[data-nf-stroke]");

    const tl = gsap.timeline({ delay: 0.2, defaults: { ease: "power3.out" } });
    if (code) {
      tl.from(
        splitChars(code, { clipTop: false }),
        { yPercent: 40, opacity: 0, duration: 1.6, stagger: 0.12, ease: "power4.out" },
        0,
      );
    }
    tl.from(chars, { yPercent: 115, duration: 1.1, stagger: 0.02 }, 0.2).from(
      root.querySelectorAll("[data-nf-meta]"),
      { opacity: 0, y: 18, duration: 0.9, stagger: 0.12 },
      0.7,
    );
    if (stroke) {
      tl.fromTo(
        stroke,
        { strokeDashoffset: 1 },
        { strokeDashoffset: 0, duration: 1.2, ease: "power2.inOut" },
        1,
      );
    }
  });
</script>
