---
interface Props {
  quote: string;
  body: string;
}

const { quote, body } = Astro.props;
---

<section
  id="about"
  data-philosophy
  class="mx-auto max-w-5xl scroll-mt-20 px-5 py-18 text-center sm:px-8 sm:py-26"
>
  <p class="display text-3xl leading-[1.15] sm:text-5xl lg:text-6xl" data-quote>
    {quote}
  </p>
  <p class="text-muted-foreground mx-auto mt-10 max-w-xl text-[15px] leading-relaxed">
    {body}
  </p>
</section>

<script>
  import { initGsap, splitWords } from "@/lib/motion";

  const root = document.querySelector<HTMLElement>("[data-philosophy]");

  initGsap(root, ({ gsap, root, reduced }) => {
    if (reduced) return;
    const quote = root.querySelector<HTMLElement>("[data-quote]");
    if (!quote) return;
    const words = splitWords(quote);
    gsap.from(words, {
      opacity: 0.12,
      duration: 0.6,
      ease: "none",
      stagger: 0.6,
      scrollTrigger: {
        trigger: root,
        start: "top 75%",
        end: "bottom 65%",
        scrub: 0.6,
      },
    });
  });
</script>
