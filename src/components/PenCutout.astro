---
interface Props {
  src: string;
  class?: string;
  loading?: "lazy" | "eager";
  fetchpriority?: "high" | "low" | "auto";
}

const { src, class: className, loading = "lazy", fetchpriority = "auto" } = Astro.props;

// Pen silhouette traced from the five pen renders, in their 1920×1080 pixel space.
const PEN_OUTLINE =
  "M955 70L939 75L926 85L917 102L916 114L901 115L902 116L900 117L903 144L902 197L904 383L900 413L904 416L916 417L905 419L916 420L917 428L917 769L919 772L928 773L929 775L929 890L931 896L942 901L944 939L947 943L952 997L954 1002L957 1002L959 1001L961 972L968 941L976 920L988 905L987 904L992 895L992 776L993 773L1001 772L1004 769L1004 108L1000 94L992 83L981 74L965 70Z";

const mask = `url("data:image/svg+xml,${encodeURIComponent(
  `<svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 1920 1080" preserveAspectRatio="none"><filter id="f"><feGaussianBlur stdDeviation="1.2"/></filter><path d="${PEN_OUTLINE}" filter="url(#f)"/></svg>`,
)}")`;
---

<div class:list={["pen-cutout", className]} style={`--pen-mask:${mask}`} aria-hidden="true">
  <img src={src} alt="" loading={loading} fetchpriority={fetchpriority} />
</div>

<style>
  /* Only the pen from the studio render, with its backdrop masked away. */
  .pen-cutout {
    position: absolute;
    inset: 0;
  }

  .pen-cutout img {
    position: absolute;
    top: 0;
    left: 50%;
    height: 100%;
    width: auto;
    max-width: none;
    transform: translateX(-50%);
    -webkit-mask: var(--pen-mask) center / 100% 100% no-repeat;
    mask: var(--pen-mask) center / 100% 100% no-repeat;
  }
</style>
