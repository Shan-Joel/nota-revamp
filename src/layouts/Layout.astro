---
import { Font } from "astro:assets";
import "@/styles/global.css";

interface Props {
  title: string;
  description: string;
  themeColor: string;
  ogImage: string;
  noindex?: boolean;
  /** Other origins the page streams media from, connected to early. */
  preconnect?: string[];
}

const { title, description, themeColor, ogImage, noindex = false, preconnect = [] } = Astro.props;
---

<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{title}</title>
    <meta name="description" content={description} />
    {noindex && <meta name="robots" content="noindex, nofollow" />}
    <meta name="theme-color" content={themeColor} />

    <meta property="og:type" content="website" />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:image" content={ogImage} />
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:image" content={ogImage} />

    {preconnect.map((origin) => <link rel="preconnect" href={origin} />)}
    <!-- Preload only what the first screen paints: the display face and body text. -->
    <Font
      cssVariable="--font-instrument-serif"
      preload={[{ weight: 400, style: "normal", subset: "latin" }]}
    />
    <Font cssVariable="--font-inter" preload={[{ weight: 400, style: "normal", subset: "latin" }]} />
    <link rel="icon" href="/favicon.ico" sizes="32x32" />
    <link rel="icon" href="/favicon.svg" type="image/svg+xml" />
    <link rel="apple-touch-icon" href="/apple-touch-icon.png" />
    <link rel="manifest" href="/site.webmanifest" />
  </head>
  <body>
    <slot />
  </body>
</html>
