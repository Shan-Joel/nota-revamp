    "code": { "type": "string", "required": true, "default": "404" },
    "eyebrow": { "type": "string", "required": true },
    "headline": { "type": "string", "required": true },
    "headlineItalic": { "type": "string", "required": true },
    "body": { "type": "text", "required": true },
    "primaryCta": { "type": "component", "repeatable": false, "component": "shared.link", "required": true },
    "secondaryCta": { "type": "component", "repeatable": false, "component": "shared.link", "required": true }
  }
